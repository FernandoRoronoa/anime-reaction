
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Anime Reaction</title>
  <style>
    body {
      margin: 0;
      background: #111116;
      color: #fff;
      font-family: Arial, sans-serif;
    }
    header {
      padding: 18px 5%;
      background: #1c1c25;
      border-bottom: 1px solid #333;
    }
    main {
      max-width: 1100px;
      margin: 30px auto;
      padding: 0 18px;
    }
    .layout {
      display: grid;
      grid-template-columns: 3fr 1fr;
      gap: 20px;
    }
    video {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
      border-radius: 10px;
    }
    select, button {
      padding: 12px;
      border-radius: 7px;
      border: 1px solid #444;
      background: #252530;
      color: white;
    }
    .panel {
      padding: 15px;
      background: #1c1c25;
      border-radius: 10px;
    }
    @media(max-width:700px) {
      .layout { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header>
    <strong>ANIME REACTION</strong>
  </header>

  <main>
    <h1>Ver anime</h1>
    <p>Selecciona un episodio para comenzar.</p>

    <div class="layout">
      <section>
        <video id="player" controls playsinline></video>
        <p id="status">Esperando selección.</p>
      </section>

      <aside class="panel">
        <h3>Episodios</h3>
        <select id="episodes">
          <option value="">Seleccionar episodio</option>
          <option value="ep1">Episodio de prueba 1</option>
          <option value="ep2">Episodio de prueba 2</option>
        </select>
        <p>Directo del streamer</p>
        <p>Abre Twitch en otra pestaña para escuchar la reacción.</p>
      </aside>
    </div>
  </main>

  <script>
    const videos = {
      ep1: "URL_DE_VIDEO_AUTORIZADO_1.mp4",
      ep2: "URL_DE_VIDEO_AUTORIZADO_2.mp4"
    };

    const player = document.getElementById("player");
    const episodes = document.getElementById("episodes");
    const status = document.getElementById("status");

    episodes.addEventListener("change", () => {
      const url = videos[episodes.value];

      if (!url) {
        player.pause();
        player.removeAttribute("src");
        status.textContent = "Selecciona un episodio.";
        return;
      }

      player.src = url;
      player.load();
      status.textContent = "Video listo para reproducir.";
    });
  </script>
</body>
</html>
